# Backend API root. No secrets here - VITE_ variables ship inside the bundle.
VITE_API_URL=http://localhost:8080/api/v1

# Read only by Docker Compose (docker-compose.yml), never by Vite: host path to
# the backend's docs/ directory, mounted read-only into the node service so
# `npm run sync:error-codes` can reach error-codes.json. The default below is
# correct once this repository lives as `frontend/`, a sibling of `backend/`.
# Override it (e.g. in a worktree, which sits one level deeper) via a local
# .env that is never committed.
BACKEND_DOCS=../backend/docs
